# Copier ce fichier en .env (jamais commité) et remplir les valeurs.
# Sur Vercel : Project Settings > Environment Variables.

# URL de la base PostgreSQL (Neon, Supabase, Vercel Marketplace...)
DATABASE_URL=postgresql://utilisateur:motdepasse@hote:5432/hopital?sslmode=require

# Clé secrète pour signer les JWT (longue chaîne aléatoire)
# Générer avec : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=changez-moi

NODE_ENV=development
PORT=3000
